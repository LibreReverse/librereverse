diff --git a/src/whisper.cpp b/src/whisper.cpp
index f0f08c7..b5b8d19 100644
--- a/src/whisper.cpp
+++ b/src/whisper.cpp
@@ -7891,8 +7891,46 @@ int whisper_full(
             ctx->state->result_all.clear();
             return 0;
         }
-        samples = vad_samples.data();
-        n_samples = vad_samples.size();
+        // LibreReverse: decode separate utterances on their original clock.
+        // Concatenating distant speech ranges lets token alignment stretch a
+        // word across minutes of removed silence. Retain short natural pauses.
+        const auto speech = ctx->state->vad_segments;
+        ctx->state->has_vad_segments = false;
+        ctx->state->vad_segments.clear();
+        ctx->state->vad_mapping_table.clear();
+        decltype(ctx->state->result_all) result;
+        params.vad = false;
+        params.no_context = true;
+        params.offset_ms = 0;
+        params.duration_ms = 0;
+        params.new_segment_callback = nullptr;
+        for (size_t i = 0; i < speech.size(); ) {
+            int64_t begin = speech[i].orig_start;
+            int64_t end = speech[i].orig_end;
+            ++i;
+            while (i < speech.size() && speech[i].orig_start - end <= 200) {
+                end = speech[i].orig_end;
+                ++i;
+            }
+            begin = std::max<int64_t>(0, begin - 20);
+            const int first = std::min<int64_t>(n_samples, begin * WHISPER_SAMPLE_RATE / 100);
+            const int last = std::min<int64_t>(n_samples, (end + 20) * WHISPER_SAMPLE_RATE / 100);
+            if (last <= first) continue;
+            const int status = whisper_full_with_state(ctx, ctx->state, params, samples + first, last - first);
+            if (status != 0) return status;
+            for (auto segment : ctx->state->result_all) {
+                segment.t0 += begin;
+                segment.t1 += begin;
+                for (auto & token : segment.tokens) {
+                    if (token.t0 >= 0) token.t0 += begin;
+                    if (token.t1 >= 0) token.t1 += begin;
+                    if (token.t_dtw >= 0) token.t_dtw += begin;
+                }
+                result.push_back(std::move(segment));
+            }
+        }
+        ctx->state->result_all = std::move(result);
+        return 0;
     }
     return whisper_full_with_state(ctx, ctx->state, params, samples, n_samples);
 }
